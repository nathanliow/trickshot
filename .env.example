# The only thing this app needs. Any Helius key with archival RPC access.
# getTransactionsForAddress is a Helius-exclusive method on Developer and up.
# Optional if visitors bring their own (see BYOK below): without any key the
# gallery still renders from cache and anything else asks for one.
HELIUS_API_KEY=

# Optional. Built candles are cached so a token is only reconstructed once.
# With these set the cache is shared across instances; without them it falls
# back to files in .trickshot-cache/ next to the project, which needs no setup.
#   create table trickshot_cache (id text primary key, payload jsonb not null);
# SUPABASE_URL=
# SUPABASE_KEY=            anon key on the site, service key where you index

# Optional overrides.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com
# COMMITMENT=confirmed
# HISTORY_DEBUG=1          per-phase timings on the server console
# TRICKSHOT_CACHE_DIR=     where the file cache lives (default .trickshot-cache/)

# --- Letting the site build things ---
# Everything below only matters for a deployment that is NOT read-only. Leave
# them unset and nothing changes: builds stay owner-only, counting is
# per-process, and there is no daily ceiling.

# The owner's capability over HTTP. UNSET MEANS NOBODY, which is the safe
# default and the state of every existing install — so board refreshes,
# linked-wallet graphs and whole-life rebuilds are all refused until you set
# it. Send it as `Authorization: Bearer <token>`. The indexer does not need it;
# it passes its capabilities in-process.
# TRICKSHOT_OWNER_TOKEN=

# Requests per second to Helius, PER PROCESS. Not the account ceiling — Vercel
# runs many instances and each gets its own budget, so the account sees this
# times however many are warm. Lowering it costs real latency (a 400-bar build
# is ~3,600 reads), so measure before dividing.
# HELIUS_RPS=400

# Credits per UTC day before new builds are refused. 0 disables the ceiling.
# HELIUS_DAILY_CREDITS=

# Stop all building without a redeploy.
# TRICKSHOT_DISABLE_BUILDS=1

# What one visitor may build in a day. The two catch different abuses: per-IP
# stops one person grinding a 500-token wallet, per-wallet stops the same
# wallet being farmed from many addresses.
# VISITOR_BUILDS_PER_IP=3          shown in the UI, so keep it a number people can plan around
# VISITOR_BUILDS_PER_WALLET=20

# Credits one visitor may spend in a day, across EVERYTHING. The limit that
# actually binds: the two above count builds of unknown mints only, so a
# visitor replaying wallets on tokens already indexed used to spend freely and
# increment nothing — measured in production at 2.1M credits recorded as one
# build.
# VISITOR_CREDITS_PER_DAY=150000

# Bars one queued build may draw. A whole-life chart is capped at 400; nothing
# capped a window, so a bad merge produced a 2,833-bar job estimated at 481,780
# credits.
# BUILD_MAX_BARS=1000
# QUEUE_MAX_WINDOWS=6

# Bounds on the one build a visitor can start — a wallet's own window.
# MAX_BARS is bars MISSING from the cache, not bars shown, so an indexed token
# is unaffected; it refuses the cold long-held position that would otherwise
# cost tens of thousands of credits. Refused, never quietly narrowed.
# VISITOR_MAX_BARS=60
# VISITOR_WALLET_PAGES=3        pages of the wallet's own history (owner: 12)
# VISITOR_CLUSTER=1             wallets replayed alongside it (owner: 8)

# The wallet page. Enumeration reads the wallet's TOKEN ACCOUNTS — one DAS
# call, ten credits, up to a thousand mints, names and balances included. It
# deliberately does not page transfers: a wallet with a high-frequency USDC leg
# spends any transfer budget before reaching a single trade (measured: 2,000
# transfers, 200 credits, one token found — the same wallet's accounts are 329
# mints in one call).
# WALLET_ASSET_PAGES=3
# WALLET_MAX_ROWS=50
# WALLET_MAX_ENRICH=10

# --- The indexing queue ---
# A token too expensive to draw on demand is queued instead, and a cron builds
# it once for everyone who asks. This is the only thing here that spends money
# with nobody watching, so it is off until CRON_SECRET is set.

# Vercel signs its cron requests with this. UNSET MEANS THE WORKER REFUSES
# EVERYONE, which is the right default for a route whose only job is to spend.
# CRON_SECRET=

# QUEUE_PER_TICK=1        builds per cron firing; the cron runs every minute
# QUEUE_MAX_DEPTH=50      queued tokens before new asks are turned away
# QUEUE_MAX_ATTEMPTS=2    a token that keeps failing is usually unreadable
# QUEUE_STALE_SEC=900     a claim older than this is treated as a dead worker

# What a visitor may spend drawing one wallet's window before it is queued
# instead. Priced BEFORE building — counting signatures costs ~200 credits and
# predicted 63,300 against 62,603 actual on the window it refused.
# VISITOR_MAX_CREDITS=25000

# Counters and the credit ceiling need scripts/migrate.sql applied. Without it
# they fall back to per-process counting, which is correct for one server and
# lenient by however many instances are warm on serverless.

# --- Visitor keys (BYOK) ---
# A visitor can paste their own Helius key, kept in their browser and sent as
# an `X-Helius-Key` header. Every limit above exists to protect YOUR account,
# so none of them applies to a request paying its own way — and its spend is
# not counted, so BYOK traffic cannot close the day for anyone else.
# Still enforced: MAX_CONCURRENT_BUILDS and TRICKSHOT_DISABLE_BUILDS, which
# bound function time rather than money. Trader boards stay owner-only.

# Ignore visitor keys and hide the control. Worth setting on a read-only
# deployment, where a BYOK build cannot be persisted and is rebuilt every time.
# TRICKSHOT_DISABLE_BYOK=1

# Bounds on one BYOK request — not credits, which are theirs, but what a single
# function holds at once.
# BYOK_MAX_BARS=1000            bars one request may build
# BYOK_WALLET_PAGES=12          pages of the wallet's own history
# BYOK_CLUSTER=8                wallets replayed alongside the subject

# --- Hosting ---
# A deployed copy serves a curated set: visitors read and replay everything,
# and nothing new gets built on the request path. Index locally instead:
#   npm run index -- <mint> --top 5
# TRICKSHOT_READONLY=1
